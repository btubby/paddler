# Copy to .env for local `netlify dev`. On Netlify, add these under
# Site configuration -> Environment variables (tick "Contains secret values").
# Never commit the real values.
MEMBERMOJO_EMAIL=
MEMBERMOJO_PASSWORD=

# Optional: how to tell coaches from paddlers. Comma-separated words matched (case-insensitive)
# against the text MemberMojo shows next to each member (e.g. membership type or group).
# Run the debug call in the README to see what that text looks like.
# COACH_MATCH=coach
# PADDLER_MATCH=paddler

# Optional overrides
# MEMBERMOJO_BASE=https://membermojo.co.uk
# MEMBERMOJO_ORG=bscc
# MEMBERMOJO_DIRECTORY_PATH=/bscc/yourmembership/directory
# MEMBERS_DEBUG=1

# Live site: MemberMojo blocks sign-ins from Netlify's servers (Cloudflare challenge), so
# `npm run sync-members` runs on your computer and uploads the member list to the site.
# SYNC_TOKEN: a long random secret (`openssl rand -base64 24`), set here AND on Netlify.
SYNC_TOKEN=
# Your deployed site, used by the sync command
SYNC_SITE_URL=https://your-site.netlify.app
# On Netlify set MEMBERS_SOURCE=upload so the site never tries MemberMojo directly.
# MEMBERS_SOURCE=upload

# Under-18 cards are tinted orange using each member's "Age" profile field
# (only an under-18 flag is kept). Costs one page load per member per sync.
# MEMBERS_PROFILES=off

# Sign in with Google: the only way into the coaches' pages and the race planner. Coaches and the race
# coordinator are listed on the site's /roles/ page (an admin does that).
#  GOOGLE_CLIENT_ID: Google Cloud console -> APIs & Services -> Credentials -> Create credentials ->
#    OAuth client ID -> Web application. Authorised JavaScript origins: https://bscc-coach.netlify.app
#    and http://localhost:8888 (no redirect URI needed). Set up the OAuth consent screen first
#    (External, only the basic email/profile scopes). It is not a secret.
#  SESSION_SECRET: a long random string that signs the sign-in cookie (`openssl rand -base64 32`).
#    Changing it signs everyone out.
#  ADMIN_EMAILS: comma-separated Google accounts that are always admins (they can edit /roles/).
# GOOGLE_CLIENT_ID=
# SESSION_SECRET=
# ADMIN_EMAILS=you@example.com

# Optional: signs the links coaches share with paddlers (/my-racing/). Without it, one is
# made from SESSION_SECRET. Changing it stops every link already shared.
# SHARE_LINK_SECRET=

# Strava (/my-training/: paddlers connect their own Strava and see their own training charts).
# From the club's Strava API application: https://www.strava.com/settings/api
# Set its "Authorization Callback Domain" to the site's domain (localhost for netlify dev).
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
